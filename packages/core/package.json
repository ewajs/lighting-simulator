{
  "name": "@luxstudio/core",
  "version": "0.5.8",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./analysis": "./src/analysis/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "coverage": "vitest run --coverage --coverage.include='src/**/*.ts' --coverage.exclude='src/**/*.test.ts' --coverage.exclude='src/generated/**' --coverage.exclude='src/dev/**' --coverage.reporter=text-summary --coverage.reporter=html",
    "mutation-check": "node scripts/mutation-check.js",
    "bench": "vite build --ssr scripts/bench-analysis.ts --outDir .bench --emptyOutDir --logLevel warn && node .bench/bench-analysis.js"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/three": "0.186.0"
  }
}
