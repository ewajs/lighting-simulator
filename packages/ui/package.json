{
  "name": "@luxstudio/ui",
  "version": "0.5.6",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./theme.css": "./src/theme.css"
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "coverage": "vitest run --coverage --coverage.include='src/**/*.ts' --coverage.exclude='src/**/*.test.ts' --coverage.exclude='src/generated/**' --coverage.exclude='src/dev/**' --coverage.reporter=text-summary --coverage.reporter=html",
    "i18n:extract": "lit-localize extract",
    "i18n:build": "lit-localize build",
    "i18n:check": "lit-localize extract && lit-localize build 2>&1 | tee /dev/stderr | (! grep -q 'is missing')"
  },
  "dependencies": {
    "@luxstudio/core": "0.5.6",
    "@lit/localize": "0.12.2",
    "lit": "3.3.3",
    "lucide": "1.55.0"
  }
}
