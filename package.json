{
  "name": "luxstudio",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "accuracy/typescript"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run dev -w apps/demo",
    "build": "npm run build -w apps/demo",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "coverage": "npm run coverage --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test -c apps/demo",
    "test:e2e:quick": "playwright test -c apps/demo --project=chrome",
    "i18n:extract": "npm run i18n:extract -w packages/ui",
    "i18n:build": "npm run i18n:build -w packages/ui",
    "i18n:check": "npm run i18n:check -w packages/ui",
    "docs": "typedoc && uv run --directory accuracy/python pdoc luxstudio_accuracy --docformat google --footer-text 'Lux Studio accuracy' -o ../../apps/demo/dist/docs/accuracy",
    "manual": "npm run build -w apps/manual",
    "manual:dev": "npm run dev -w apps/manual",
    "manual:screenshots": "npm run screenshots -w apps/manual",
    "accuracy:check": "cd accuracy/python && uv run ruff check && uv run ruff format --check && uv run mypy && uv run pytest",
    "accuracy:references": "uv run --directory accuracy/python accuracy references && npm run accuracy:report",
    "accuracy:report": "npm run report -w accuracy/typescript",
    "accuracy:docs": "uv run --directory accuracy/python pdoc luxstudio_accuracy --docformat google",
    "accuracy:patch-size": "npm run patch-size -w accuracy/typescript",
    "accuracy:source-cell": "npm run source-cell -w accuracy/typescript",
    "accuracy:timings": "npm run timings -w accuracy/typescript"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@lit/localize-tools": "0.8.2",
    "@playwright/test": "1.64.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "typedoc": "0.28.20",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
